---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/uliboooo.css";

const l = [
  {
    name: "伊吹静香は20歳になった",
    links: [
      {
        type: "カクヨム",
        link: "https://kakuyomu.jp/works/2912051601683894129",
      },
      {
        type: "X",
        link: "https://x.com/Uliboooo/status/2059643951817404723?s=20",
      }
    ]
  },
];
---

<BaseLayout title="Lilan" activeTab="lilan">
  <div class="about_me">
    <div class="main_content">
      <h2 id="lilan">Lilan (梨藍)</h2>
      <p>
        創作物などに向けた名義。Ulibooooの中の人ともいう。
      </p>

      <blockquote class="favorites">
        <p>
          好きな物:<br />
          文字, パスタ, かわいいもの, 軽さ, 雨, 睡眠, Vim, 紙袋
        </p>
      </blockquote>
      <blockquote class="dislikes">
        <p>
          嫌いなもの:<br />
          右クリック, 細かいUI, 多機能, 複雑な料金プラン
        </p>
      </blockquote>

      <h2 id="works">Works</h2>

      {
        l.map((work) => (
          <div class="work-item">
            <h3>{work.name}</h3>
            <div class="work-links">
              {work.links.map((p) => (
                <a href={p.link} target="_blank" class="link--external" rel="noopener noreferrer">
                  <span style="font-size: 1rem;">{p.type}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
