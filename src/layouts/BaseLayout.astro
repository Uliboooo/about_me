---
import "../styles/global.css";
const { title, activeTab } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/uliboooo.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="/fonts/MapleMono-Variable/MapleMono[wght].ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>{title} | Lilan</title>
  </head>
  <body>
    <header class="page-header">
      <div>
        <a
          href="/uliboooo"
          class={`link--underline head-title ${activeTab === "uliboooo" ? "is-active" : ""}`}
        >
          Uliboooo
        </a>
        <span class="head-title"> | </span>
        <a
          href="/lilan"
          class={`link--underline head-title ${activeTab === "lilan" ? "is-active" : ""}`}
        >
          Lilan
        </a>
      </div>
    </header>

    <main class="page-main">
      <slot />
    </main>

    <footer>
      <div>
        2026
      </div>
    </footer>
  </body>
</html>
