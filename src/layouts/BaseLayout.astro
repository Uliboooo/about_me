---
import "../styles/global.css";
const { title, activeTab } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/uliboooo.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="/fonts/Monaspace Neon/Monaspace Neon Var.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Yomogi/Yomogi-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/AnnotationMono-VF.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <title>{title} / Lilan</title>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body>
    <header class="page-header">
      <div>
        <a
          href="/uliboooo"
          class={`link--underline head-title ${activeTab === "uliboooo" ? "is-active" : ""}`}
        >
          Uliboooo
        </a>
        <span class="head-title"> / </span>
        <a
          href="/lilan"
          class={`link--underline head-title ${activeTab === "lilan" ? "is-active" : ""}`}
        >
          Lilan
        </a>
      </div>
      <div class="header-right">
        <a
          href="https://blog.uliboooo.dev/"
          target="_blank"
          rel="noopener noreferrer"
          class="blog-link"
          title="blog"
        >
          <span class="icon" style="--icon-url: url(/icons/blog/logo_black.svg)"></span>
          <span class="blog-text">Blog</span>
        </a>
        <button id="themeToggle" class="theme-toggle" aria-label="Toggle theme">
          <span class="sun-icon">
            <svg xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 44 44"
              fill="none"
              stroke="#f59e0b"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="transform: translateY(1px);"
              aria-hidden="true">
              <circle cx="22" cy="22" r="7"/>
              <line x1="22" y1="3"  x2="22" y2="8"/>
              <line x1="22" y1="36" x2="22" y2="41"/>
              <line x1="3"  y1="22" x2="8"  y2="22"/>
              <line x1="36" y1="22" x2="41" y2="22"/>
              <line x1="8"  y1="8"  x2="11.5" y2="11.5"/>
              <line x1="32.5" y1="32.5" x2="36" y2="36"/>
              <line x1="36" y1="8"  x2="32.5" y2="11.5"/>
              <line x1="11.5" y1="32.5" x2="8"  y2="36"/>
            </svg>
          </span>
          <span class="moon-icon">
            <svg xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 44 44"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="transform: translateY(1px);"
              aria-hidden="true">
              <!-- outer moon -->
              <path d="M28 6
                C18 7, 11 15, 11 24
                C11 33, 18 39, 27 39
                C33 39, 38 36, 41 31
                C35 32, 29 30, 24 25
                C19 20, 17 13, 18 7
                C21 6, 24 5.5, 28 6Z"/>
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main class="page-main">
      <slot />
    </main>

    <footer>
      <div>
        © 2026 Uliboooo. <a href="https://github.com/Uliboooo/about_me" target="_blank" rel="noopener noreferrer" class="link--underline external-link">View Source</a>
      </div>
    </footer>

    <script is:inline>
      const handleToggleClick = () => {
        const element = document.documentElement;
        element.setAttribute('data-theme', element.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');

        const isDark = element.getAttribute('data-theme') === 'dark';
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };

      document.getElementById('themeToggle').addEventListener('click', handleToggleClick);
    </script>
  </body>
</html>
